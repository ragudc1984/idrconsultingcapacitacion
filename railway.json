{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @idr/api"
  },
  "deploy": {
    "startCommand": "npm run start -w @idr/api",
    "preDeployCommand": ["npx -w @idr/api prisma migrate deploy"],
    "healthcheckPath": "/salud",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
