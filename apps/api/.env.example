# Copia este archivo como .env en apps/api y completa los valores. El .env real
# esta en .gitignore y nunca se commitea.

# Cadena de conexion de PostgreSQL (Neon). Es secreta: vive en este .env en
# desarrollo y en las variables del servicio de Railway en produccion. Usa la
# conexion directa (sin "-pooler") y sslmode=verify-full, que verifica el
# certificado del servidor.
DATABASE_URL="postgresql://usuario:contrasena@servidor/basededatos?sslmode=verify-full"

# Puerto del API. En Railway lo asigna la plataforma; en desarrollo, 3000.
PORT=3000

# Origenes que pueden llamar al API desde un navegador, separados por coma.
# Nunca "*". En desarrollo, el servidor de Vite.
CORS_ORIGINS="http://localhost:5173"
