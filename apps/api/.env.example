# Copia este archivo como .env en apps/api y completa los valores. El .env real
# esta en .gitignore y nunca se commitea.

# Cadena de conexion de PostgreSQL (Neon). Es secreta: vive en este .env en
# desarrollo y en las variables del servicio de Render en produccion.
DATABASE_URL="postgresql://usuario:contrasena@servidor/basededatos?sslmode=require"

# Puerto del API. En Render lo asigna la plataforma; en desarrollo, 3000.
PORT=3000

# Origenes que pueden llamar al API desde un navegador, separados por coma.
# Nunca "*". En desarrollo, el servidor de Vite.
CORS_ORIGINS="http://localhost:5173"
