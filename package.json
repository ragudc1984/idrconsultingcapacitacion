{
  "name": "capacitacion-idr-consulting",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @idr/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint",
    "verify": "npm ci && npm run build && npm run lint",
    "preview": "npm run preview -w @idr/web"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0"
  }
}
